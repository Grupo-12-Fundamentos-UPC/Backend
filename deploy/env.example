# Common academic deployment variables for Google Cloud Run, Azure Container Apps, or AWS App Runner.
# Replace DATABASE_URL and Jwt__Secret before deploying.

ASPNETCORE_ENVIRONMENT=Academic
PORT=8080

Deployment__EnableSwagger=true
Deployment__RunMigrations=true
Deployment__SeedAdmin=true
Storage__UploadsPath=/tmp/hairypaws/uploads

DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/hairy_paws?sslmode=require

Jwt__Issuer=HairyPaws.Api.Academic
Jwt__Audience=HairyPaws.Clients.Academic
Jwt__Secret=ChangeThisAcademicSecret123456789012
Jwt__AccessTokenLifetimeMinutes=30
Jwt__RefreshTokenLifetimeDays=14

Seed__AdminUser__Email=admin@hairypaws.academic
Seed__AdminUser__Password=Admin123!
Seed__AdminUser__FirstName=Academic
Seed__AdminUser__LastName=Administrator

